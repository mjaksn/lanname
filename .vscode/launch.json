{
  // Run configurations for this repository and for the two tools under
  // tools/. Lint and types are not here: ruff and mypy are in tasks.json,
  // since running a checker under the debugger buys nothing.
  //
  // Each tool's entries set their working directory to the tool's own
  // directory, and that is load-bearing rather than tidiness.
  // "python -m lanname_poker" and "python -m lanname_harness" only resolve
  // from there, and each tool finds the lanname checkout by walking up from
  // it, so those entries must not be moved to the workspace root.
  //
  // Both windows need PySide6 in whichever interpreter is selected:
  //   pip install --require-hashes -r tools/poker/requirements.txt
  //   pip install --require-hashes -r tools/harness/requirements.txt
  // The two pin the same version, so either install serves both. Nothing else
  // here needs anything installed.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lanname: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "poker: window",
      "type": "debugpy",
      "request": "launch",
      "module": "lanname_poker",
      "cwd": "${workspaceFolder}/tools/poker",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "poker: selftest",
      "type": "debugpy",
      "request": "launch",
      "module": "lanname_poker",
      "args": ["--selftest"],
      "cwd": "${workspaceFolder}/tools/poker",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "poker: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-v"],
      "cwd": "${workspaceFolder}/tools/poker",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "harness: window",
      "type": "debugpy",
      "request": "launch",
      "module": "lanname_harness",
      "cwd": "${workspaceFolder}/tools/harness",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "harness: selftest",
      "type": "debugpy",
      "request": "launch",
      "module": "lanname_harness",
      "args": ["--selftest"],
      "cwd": "${workspaceFolder}/tools/harness",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "harness: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-v"],
      "cwd": "${workspaceFolder}/tools/harness",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
